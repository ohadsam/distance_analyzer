{
  "reducedMotion": "static final state; no looping",
  "animations": {
    "route-progress": {
      "target": "path",
      "property": "stroke-dashoffset",
      "from": 1,
      "to": 0,
      "durationMs": 650,
      "easing": "ease-out"
    },
    "badge-reveal": {
      "target": "root",
      "property": "opacity",
      "from": 0,
      "to": 1,
      "durationMs": 240
    },
    "record-update": {
      "target": "root",
      "property": "scale",
      "keyframes": [
        1,
        1.04,
        1
      ],
      "durationMs": 320
    }
  }
}