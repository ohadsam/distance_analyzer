      "frames": [
        {
          "offset": 0,
          "transform": "translateY(-18px)",
          "opacity": 0
        },
        {
          "offset": 0.65,
          "transform": "translateY(3px)",
          "opacity": 1
        },
        {
          "offset": 1,
